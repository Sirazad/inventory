# API URL Configuration
# 
# For Docker Compose deployment (default):
# Leave this unset or commented out - nginx will proxy /api to the backend service
# REACT_APP_API_URL=
#
# For individual service deployment (e.g., Zeabur):
# Set this to your backend's full URL
# REACT_APP_API_URL=https://your-backend-url.zeabur.app/api
